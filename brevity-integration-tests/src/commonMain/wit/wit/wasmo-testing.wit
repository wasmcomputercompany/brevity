package wasmo:testing;

interface calculator {
  multiply: func(a: s64, b: s64) -> s64;
}

interface stdio {
  print-greeting: func(name: string);
  print-error: func(name: string);
}

/// Perform send or receive operations on the guest, but orchestrate from the host.
interface streams {
  resource sender-tester {
    is-receiver-closed: func() -> bool;
    await-receive-or-fail: async func() -> result<_, failure>;
    send-some-or-fail: async func(values: list<string>) -> result<s32, failure>;
    cancel-send: async func();
    close-or-fail: func() -> result<_, failure>;
  }

  resource receiver-tester {
    is-sender-closed: func() -> bool;
    await-send-or-fail: async func() -> result<_, failure>;
    receive-or-fail: async func(count: s32) -> result<list<string>, failure>;
    cancel-receive: async func();
    close-or-fail: func() -> result<_, failure>;
  }

  variant failure {
    canceled,
    concurrent-modification,
    illegal-state(option<string>),
  }

  /// Guest sender, host receiver.
  create-guest-host: func() -> tuple<sender-tester, stream<string>>;
  /// Host sender, guest receiver.
  create-host-guest: func(%stream: stream<string>) -> receiver-tester;
  /// Guest sender, guest receiver.
  create-guest-guest: func() -> tuple<sender-tester, receiver-tester>;
}

interface unit-streams {
  resource unit-sender-tester {
    send-some: async func(count: s32, fast: bool) -> s32;
  }

  resource unit-receiver-tester {
    receive: async func(count: s32, fast: bool) -> s32;
  }

  create-guest-host: func() -> tuple<unit-sender-tester, stream>;
  create-host-guest: func(%stream: stream) -> unit-receiver-tester;
  create-guest-guest: func() -> tuple<unit-sender-tester, unit-receiver-tester>;
}

world wasmo-testing {
  export calculator;
  export stdio;
  export streams;
  export unit-streams;
  export sum: func(a: s64, b: s64) -> s64;
  export concat: func(a: string, b: string) -> string;
  export parallel-sleep: async func(coroutine-count: u32, duration-millis: u64);
}
